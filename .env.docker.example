# Copy this file to .env.docker. These default addresses run the complete stack
# locally through Caddy. For a server, replace the addresses with real domains
# and set NODE_ENV=production.
NODE_ENV=development
POSTGRES_DB=voro
POSTGRES_USER=voro
POSTGRES_PASSWORD=voro_local_password
JWT_SECRET=local-voro-jwt-secret-change-before-online-deployment
PAYMENT_CARD_ENCRYPTION_KEY=c1b8b42e94d6e1a70cc7ab79e0265ab3e124a36647bc67194249c166d55a2f0e
CADDY_EMAIL=local@localhost
CUSTOMER_ADDRESS=http://localhost
RESTAURANT_ADDRESS=http://restaurant.localhost
DRIVER_ADDRESS=http://driver.localhost
ADMIN_ADDRESS=http://admin.localhost
API_ADDRESS=http://api.localhost
API_URL=http://api.localhost
VITE_API_URL=http://api.localhost
CLIENT_URLS=http://localhost,http://restaurant.localhost,http://driver.localhost,http://admin.localhost
DRIVER_APP_URL=http://driver.localhost
RESTAURANT_APP_URL=http://restaurant.localhost
DELIVERY_TIMEOUT_MINUTES=90
VAPID_SUBJECT=mailto:ops@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SEED_DEMO_DATA=true
# Local only: automatically moves every courier-assigned delivery for a live demo.
LOCAL_DELIVERY_DEMO=true
LOCAL_DELIVERY_DEMO_INTERVAL_MS=1200
LOCAL_DELIVERY_DEMO_STEP_METERS=90

# Auth0 Google login. Create a Regular Web Application in Auth0, enable the
# Google social connection, then copy these values from the Auth0 dashboard.
# The callback URL must also be listed in Auth0's Allowed Callback URLs.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=http://api.localhost/auth/auth0/callback
AUTH0_CLIENT_REDIRECT_URL=http://localhost/auth/callback
VITE_AUTH0_GOOGLE_ENABLED=true

# Expose data services only to this machine so native API development can use
# Redis at localhost:6379 and PostgreSQL at localhost:5433.
REDIS_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=6379
DATABASE_HOST_BIND=127.0.0.1
DATABASE_HOST_PORT=5433
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# Leave SMTP empty for a local preview. Add real SMTP details only when email sending is needed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
