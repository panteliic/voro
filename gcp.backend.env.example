# Your domain is managed in Cloudflare. Do not include https:// here.
DOMAIN=example.com
CADDY_EMAIL=replace-with-your-email@example.com

# Exact HTTPS URLs of the Pages deployments, one for each application.
CUSTOMER_APP_URL=https://voro-customer.pages.dev
RESTAURANT_APP_URL=https://voro-restaurant.pages.dev
DRIVER_APP_URL=https://voro-driver.pages.dev
ADMIN_APP_URL=https://voro-admin.pages.dev

POSTGRES_DB=voro
POSTGRES_USER=voro
POSTGRES_PASSWORD=replace_with_a_unique_database_password
JWT_SECRET=replace_with_a_unique_64_character_hex_secret
PAYMENT_CARD_ENCRYPTION_KEY=replace_with_a_unique_64_character_hex_key
OBSERVABILITY_TOKEN=replace_with_a_unique_64_character_hex_secret

# Google login through Auth0. These must be production credentials and URLs.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=https://api.example.com/auth/auth0/callback
AUTH0_CLIENT_REDIRECT_URL=https://voro-customer.pages.dev/auth/callback

# Optional services.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
