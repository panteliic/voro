{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@/*":          ["./src/*"],
      "@voro/shared": ["../../packages/shared/src/index.ts"],
      "@voro/ui":     ["../../packages/ui/src/index.ts"],
      "@voro/socket": ["../../packages/socket/src/index.ts"]
    }
  },
  "include": ["src"]
}