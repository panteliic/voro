# The VM's current public IP is 34.116.215.26. sslip.io resolves this hostname
# and its subdomains to that IP, allowing a free HTTPS demo without buying a domain.
DOMAIN=34-116-215-26.sslip.io
CADDY_EMAIL=replace-with-your-email@example.com

# Create separate random values with: openssl rand -hex 32
POSTGRES_DB=voro
POSTGRES_USER=voro
POSTGRES_PASSWORD=replace_with_a_unique_database_password
JWT_SECRET=replace_with_a_unique_64_character_hex_secret
PAYMENT_CARD_ENCRYPTION_KEY=replace_with_a_unique_64_character_hex_key

# Production must never run with demo accounts or demo orders.
SEED_DEMO_DATA=false

# Used to protect /metrics. Generate with: openssl rand -hex 32
OBSERVABILITY_TOKEN=replace_with_a_unique_64_character_hex_secret

# Leave this blank to keep the public bootstrap route disabled. Create the
# first admin locally on the VM using the command in DEPLOY_GCP.md.
ADMIN_BOOTSTRAP_TOKEN=

# Email is optional for a demo. Leave all fields blank to disable sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google login is shown by default. Facebook is not supported. Fill the Auth0
# values below before deploying; set the flag false only to intentionally hide it.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_CALLBACK_URL=https://api.34-116-215-26.sslip.io/auth/auth0/callback
AUTH0_CLIENT_REDIRECT_URL=https://34-116-215-26.sslip.io/auth/callback
VITE_AUTH0_GOOGLE_ENABLED=true

# Browser push is optional. Leave blank for now; it can be added later.
VAPID_SUBJECT=mailto:replace-with-your-email@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
